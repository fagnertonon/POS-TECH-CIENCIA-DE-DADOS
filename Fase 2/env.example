# Referencia para os parametros do job Glue. O Glue nao carrega .env automaticamente.
# Configure estes valores como Job parameters (--NOME valor); nenhuma chave secreta aqui.
AWS_REGION=us-east-2
JOB_NAME=fiap-bronze-inep-batch
BUCKET=fiap-tc-fase2-2026
PREFIX=bronze/inep
AUDIT_PREFIX=auditoria/bronze
CONNECTION_NAME=Bigquery connection
PARENT_PROJECT=fiap1-512214
SOURCE_DATASET=basedosdados.br_inep_avaliacao_alfabetizacao
TABLES=alunos,municipio,uf,meta_alfabetizacao_brasil,meta_alfabetizacao_uf,meta_alfabetizacao_municipio,dicionario
ALLOW_EMPTY=false
ALUNOS_PARTITIONS=4
SMALL_TABLE_PARTITIONS=1
# JOB_RUN_ID e fornecido pelo Glue; na ausencia dele e gerado um UUID.
# Nao reutilize IDs nem inclua credenciais Google/AWS neste arquivo.
